# Copy to .env and fill in. Nothing here is a real value.
#
#   cp .env.example .env
#
# Both docker compose and the application read this file, so there is one copy of each name.
# Four values below are placeholders and none of them is safe to keep: POSTGRES_PASSWORD,
# GOTRUE_DB_PASSWORD, GOTRUE_JWT_SECRET and DATABASE_URL. The JWT secret is deliberately too
# short to pass validation, so career-forge refuses to start until you generate a real one.
# DATABASE_URL spells the Postgres password and port out a second time, so it has to be edited
# to match. Both passwords end up inside a connection URL, so keep them to letters, digits, `-`
# and `_` (`openssl rand -hex 24`) or percent-encode them. The rest can stay.

# ---------------------------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------------------------
POSTGRES_USER=career_forge
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=career_forge

# The role GoTrue owns its `auth` schema as. Created by docker/postgres/init on first start.
GOTRUE_DB_USER=career_forge_auth
GOTRUE_DB_PASSWORD=replace-me-too

# Host port the dev compose publishes Postgres on. Change it if 5432 is taken.
POSTGRES_PORT=5432

# Address the dev compose binds its published ports to. Loopback by default: neither Postgres
# nor GoTrue should be reachable from the network while you are developing.
DEV_BIND_ADDR=127.0.0.1

# How the application connects. This repeats POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_PORT and
# POSTGRES_DB rather than referring to them, so change it whenever you change one of those.
DATABASE_URL=postgres://career_forge:replace-me@127.0.0.1:5432/career_forge

# How migrations connect. ADR 0006 wants this to be a different role from DATABASE_URL once
# row-level security is on, so that the policies apply to the application. That split lands with
# the accounts work; leave this unset until then and migrations use DATABASE_URL.
# MIGRATION_DATABASE_URL=

# ---------------------------------------------------------------------------------------------
# GoTrue
# ---------------------------------------------------------------------------------------------
# Host port the dev compose publishes GoTrue on. In production it is not published at all.
GOTRUE_PORT=9999

# Where the application reaches GoTrue. It carries the port too, so change it whenever you change
# GOTRUE_PORT. Use http://gotrue:9999 when Nuxt runs in a container.
GOTRUE_URL=http://127.0.0.1:9999

# Shared with GoTrue. It signs the login tokens, and career-forge both verifies them with it and
# derives its service key from it, so this one string is the whole trust relationship.
# Generate one:  openssl rand -base64 48
GOTRUE_JWT_SECRET=replace-me

# Seconds a login token is good for.
GOTRUE_JWT_EXP=3600

# Where the browser reaches career-forge. GoTrue uses it as its site and redirect allow list.
APP_URL=http://localhost:3000

# What GoTrue tells clients its own address is.
GOTRUE_EXTERNAL_URL=http://localhost:9999

GOTRUE_LOG_LEVEL=info

# ---------------------------------------------------------------------------------------------
# Queue
# ---------------------------------------------------------------------------------------------
# Postgres schema pg-boss keeps its tables in.
QUEUE_SCHEMA=pgboss

# ---------------------------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------------------------
# filesystem or s3. The s3 driver is a declared switch and is not implemented yet.
STORAGE_DRIVER=filesystem
STORAGE_FILESYSTEM_ROOT=./.data/storage

# Only read when STORAGE_DRIVER=s3.
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
