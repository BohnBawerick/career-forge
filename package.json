  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.0",
